rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return signedIn() && request.auth.uid in participants;
    }

    function isChatParticipant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function immutableProfileFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'lastExchangeSessionId', 'signupRewardVersion', 'username', 'usernameChangedAt', 'accountDeletionPending', 'lockedCredits', 'credits', 'trustScore', 'verified', 'email', 'id', 'verificationCount', 'peerApprovalCount', 'portfolioSkillCounts', 'portfolioTrust'
      ]);
    }
    function fixedGift(userId, rewardId, amount) {
      let rewardPath = /databases/$(database)/documents/users/$(userId)/rewards/$(rewardId);
      return !exists(rewardPath) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits']) &&
        resource.data.get('credits', 0) is int && request.resource.data.credits is int &&
        request.resource.data.credits == resource.data.get('credits', 0) + amount &&
        getAfter(rewardPath).data.amount == amount;
    }
    function reviewer() {
      return signedIn() && request.auth.token.get('verificationReviewer', false) == true;
    }
    function unchangedSkillVerification() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedName', 'verifiedLevel', 'peerApprovalCount']);
    }

    // Suggestions are private until a trusted interest moderator approves them.
    match /interestSuggestions/{suggestionId} {
      function interestModerator() {
        return signedIn() && request.auth.token.get('interestModerator', false) == true;
      }
      allow read: if signedIn() && (resource.data.status == 'approved' ||
        resource.data.ownerId == request.auth.uid || interestModerator());
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['name', 'ownerId', 'status', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60 &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow update: if interestModerator() && resource.data.status == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy']) &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    function validUsername(name) {
      return name is string && name.matches('^[a-z0-9_]{3,24}$') &&
        !(name in ['admin', 'administrator', 'coetus', 'support', 'destek', 'moderator', 'system']);
    }
    function usernameChange(userId) {
      let name = request.resource.data.get('username', '');
      let old = resource.data.get('username', '');
      let reservation = /databases/$(database)/documents/usernames/$(name);
      let oldReservation = /databases/$(database)/documents/usernames/$(old);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'usernameChangedAt']) &&
        validUsername(name) && request.resource.data.usernameChangedAt == request.time &&
        getAfter(reservation).data.userId == userId && getAfter(reservation).data.active == true &&
        (old == '' || old == name || !exists(oldReservation) || get(oldReservation).data.userId != userId ||
          getAfter(oldReservation).data.active == false);
    }
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      function validReservation() {
        let uid = request.auth.uid;
        let profile = getAfter(/databases/$(database)/documents/users/$(uid)).data;
        return validUsername(name) && request.resource.data.keys().hasOnly(['userId', 'active', 'updatedAt']) &&
          request.resource.data.userId == uid && request.resource.data.updatedAt == request.time &&
          ((request.resource.data.active == true && profile.username == name && profile.usernameChangedAt == request.time) ||
           (request.resource.data.active == false && profile.username != name));
      }
      allow create: if signedIn() && request.resource.data.active == true && validReservation();
      allow update: if signedIn() && resource.data.userId == request.auth.uid && validReservation();
      allow delete: if false;
    }
    match /profileConnections/{connectionId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/profileConnections/$(connectionId)) || isParticipant(resource.data.participants));
      allow list: if isParticipant(resource.data.participants);
      function validConnection() {
        let d = request.resource.data;
        return d.keys().hasOnly(['participants', 'confirmedBy', 'status', 'createdAt', 'updatedAt']) &&
          d.participants is list && d.participants.size() == 2 && d.participants[0] < d.participants[1] &&
          request.auth.uid in d.participants && d.confirmedBy is list &&
          d.confirmedBy.toSet().size() == d.confirmedBy.size() &&
          d.confirmedBy.toSet().hasOnly(d.participants) && request.auth.uid in d.confirmedBy &&
          d.status == (d.confirmedBy.size() == 2 ? 'confirmed' : 'pending') && d.updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(d.participants[0])) &&
          exists(/databases/$(database)/documents/users/$(d.participants[1])) &&
          !exists(/databases/$(database)/documents/accountDeletions/$(d.participants[0])) &&
          !exists(/databases/$(database)/documents/accountDeletions/$(d.participants[1]));
      }
      allow create: if signedIn() && validConnection() && request.resource.data.createdAt == request.time &&
        request.resource.data.confirmedBy == [request.auth.uid];
      allow update: if isParticipant(resource.data.participants) && validConnection() &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.createdAt == resource.data.createdAt &&
        !(request.auth.uid in resource.data.confirmedBy) &&
        request.resource.data.confirmedBy.toSet() == resource.data.confirmedBy.toSet().union([request.auth.uid].toSet());
      allow delete: if false;
    }

    // V2: two people each teach and learn; deposits return only to their owners.
    function mutualTerminal(status) { return status in ['completed', 'cancelled', 'expired']; }
    function mutualAmount(s, uid) { return s.deposits[uid]; }
    function walletDelta(s, uid, direction) {
      let path = /databases/$(database)/documents/users/$(uid);
      let before = get(path).data;
      let after = getAfter(path).data;
      let amount = mutualAmount(s, uid);
      return before.get('credits', 0) is int && before.get('lockedCredits', 0) is int &&
        after.credits is int && after.lockedCredits is int &&
        after.credits == before.get('credits', 0) + direction * amount &&
        after.lockedCredits == before.get('lockedCredits', 0) - direction * amount &&
        after.credits >= 0 && after.lockedCredits >= 0 && after.lastExchangeSessionId == s.id;
    }
    function bothWallets(s, direction) {
      return walletDelta(s, s.participants[0], direction) && walletDelta(s, s.participants[1], direction);
    }
    function mutualWalletChange(uid) {
      let id = request.resource.data.lastExchangeSessionId;
      let path = /databases/$(database)/documents/sessions/$(id);
      let before = get(path).data;
      let after = getAfter(path).data;
      let direction = before.status == 'requested' && after.status == 'active' ? -1 : 1;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'lockedCredits', 'lastExchangeSessionId']) &&
        before.schemaVersion == 2 && request.auth.uid in before.participants && uid in before.participants &&
        before.deposits == after.deposits && before.participants == after.participants &&
        ((before.status == 'requested' && after.status == 'active' && after.funded == true) ||
         (before.status in ['active', 'disputed'] && mutualTerminal(after.status) && after.settledAt == request.time)) &&
        request.resource.data.credits is int && request.resource.data.lockedCredits is int &&
        request.resource.data.credits == resource.data.get('credits', 0) + direction * before.deposits[uid] &&
        request.resource.data.lockedCredits == resource.data.get('lockedCredits', 0) - direction * before.deposits[uid] &&
        request.resource.data.credits >= 0 && request.resource.data.lockedCredits >= 0;
    }
    function mutualSkill(s, teaching, learning) {
      let t = get(/databases/$(database)/documents/users/$(teaching)/teachSkills/$(s.teachSkillIds[teaching])).data;
      let l = get(/databases/$(database)/documents/users/$(learning)/learnSkills/$(s.learnSkillIds[learning])).data;
      return t.level is int && t.level >= 1 && t.level <= 7 && s.levels[teaching] is int && s.deposits[learning] is int && s.levels[teaching] == t.level &&
        s.taughtNames[teaching] == t.name &&
        t.get('normalizedName', t.name.lower()) == l.get('normalizedName', l.name.lower()) &&
        s.deposits[learning] == t.level * 10;
    }
    function newMutual(s, id) {
      let m = getAfter(/databases/$(database)/documents/matches/$(id)).data;
      return s.keys().hasOnly(['id','matchId','schemaVersion','requesterId','receiverId','participants','participantNames',
          'teachSkillIds','learnSkillIds','taughtNames','levels','skill','credits','deposits','status','funded',
          'completionVotes','cancellationVotes','completionRequestedAt','remindedAt','disputedBy','disputeReason','settledAt','createdAt','updatedAt']) &&
        s.id == id && s.matchId == id && s.schemaVersion == 2 && s.requesterId == request.auth.uid &&
        s.participants is list && s.participants.size() == 2 && s.participants[0] < s.participants[1] &&
        s.requesterId != s.receiverId && s.participants.toSet() == [s.requesterId,s.receiverId].toSet() &&
        s.deposits.keys().hasOnly(s.participants) && s.teachSkillIds.keys().hasOnly(s.participants) &&
        s.learnSkillIds.keys().hasOnly(s.participants) && s.levels.keys().hasOnly(s.participants) &&
        s.taughtNames.keys().hasOnly(s.participants) &&
        s.status == 'requested' && s.funded == false && s.completionVotes == [] && s.cancellationVotes == [] &&
        s.completionRequestedAt == null && s.remindedAt == null && s.disputedBy == null && s.disputeReason == '' && s.settledAt == null &&
        s.createdAt == request.time && s.updatedAt == request.time &&
        m.schemaVersion == 2 && m.initiatorId == s.requesterId && m.recipientId == s.receiverId &&
        m.status == 'pending' && m.participants == s.participants && m.deposits == s.deposits &&
        m.skillName == s.skill && m.credits == s.credits && s.credits == s.deposits[s.requesterId] &&
        !exists(/databases/$(database)/documents/accountDeletions/$(s.receiverId)) &&
        mutualSkill(s,s.participants[0],s.participants[1]) && mutualSkill(s,s.participants[1],s.participants[0]);
    }
    function voteAdded(before, after) {
      return !(request.auth.uid in before) && after == before.concat([request.auth.uid]);
    }
    function noDeadlineOrOpen(s) {
      return s.completionRequestedAt == null || request.time < s.completionRequestedAt + duration.value(72,'h');
    }
    function waitingMutual(s) {
      return s.status == 'active' && s.completionVotes.size() == 1 && s.cancellationVotes == [] && s.disputedBy == null;
    }
    function finishMutual(before, after) {
      return before.funded == true && after.settledAt == request.time && bothWallets(before, 1);
    }
    function updateMutual(before, after) {
      let changed = after.diff(before).affectedKeys();
      return before.schemaVersion == 2 && request.auth.uid in before.participants && after.updatedAt == request.time && (
        // Counterparty acceptance atomically locks both, with frozen offer terms.
        (before.status == 'requested' && before.receiverId == request.auth.uid && after.status == 'active' && after.funded == true &&
          changed.hasOnly(['status','funded','updatedAt']) &&
          get(/databases/$(database)/documents/matches/$(before.id)).data.status == 'pending' &&
          getAfter(/databases/$(database)/documents/matches/$(before.id)).data.status == 'accepted' &&
          !exists(/databases/$(database)/documents/accountDeletions/$(before.requesterId)) && bothWallets(before,-1)) ||
        // Unfunded proposal can be closed, without any wallet change.
        (before.status == 'requested' && after.status == 'cancelled' && changed.hasOnly(['status','updatedAt']) &&
          getAfter(/databases/$(database)/documents/matches/$(before.id)).data.status in ['cancelled','rejected']) ||
        // First completion starts an immutable server-time deadline; second returns both deposits.
        (before.status == 'active' && before.cancellationVotes == [] && before.disputedBy == null && noDeadlineOrOpen(before) &&
          voteAdded(before.completionVotes,after.completionVotes) && (
            (before.completionVotes == [] && after.status == 'active' && after.completionRequestedAt == request.time &&
              changed.hasOnly(['completionVotes','completionRequestedAt','updatedAt'])) ||
            (before.completionVotes.size() == 1 && after.status == 'completed' &&
              changed.hasOnly(['completionVotes','status','settledAt','updatedAt']) && finishMutual(before,after)))) ||
        // Cancellation after a completion request blocks automatic expiry as a dispute.
        (before.status in ['active','disputed'] && (before.status == 'disputed' || noDeadlineOrOpen(before)) &&
          voteAdded(before.cancellationVotes,after.cancellationVotes) && (
            (before.cancellationVotes == [] && (before.completionVotes == [] || before.status == 'disputed') && after.status == before.status &&
              changed.hasOnly(['cancellationVotes','updatedAt'])) ||
            (before.cancellationVotes == [] && before.completionVotes.size() == 1 && after.status == 'disputed' && after.disputedBy == request.auth.uid &&
              after.disputeReason == 'Tamamlanma isteğinden sonra iptal istendi.' && changed.hasOnly(['cancellationVotes','status','disputedBy','disputeReason','updatedAt'])) ||
            (before.cancellationVotes.size() == 1 && after.status == 'cancelled' &&
              changed.hasOnly(['cancellationVotes','status','settledAt','updatedAt']) && finishMutual(before,after)))) ||
        // An explicit objection from the person who has not confirmed stops time-based closure.
        (waitingMutual(before) && !(request.auth.uid in before.completionVotes) && noDeadlineOrOpen(before) &&
          after.status == 'disputed' && after.disputedBy == request.auth.uid && after.disputeReason is string &&
          after.disputeReason.size() >= 10 && after.disputeReason.size() <= 500 &&
          changed.hasOnly(['status','disputedBy','disputeReason','updatedAt'])) ||
        // At most one reminder, only between 24 and 72 hours, verified by server time.
        (waitingMutual(before) && before.remindedAt == null && after.remindedAt == request.time &&
          request.time >= before.completionRequestedAt + duration.value(24,'h') && noDeadlineOrOpen(before) &&
          changed.hasOnly(['remindedAt','updatedAt'])) ||
        // Silence is not completion or an endorsement.
        (waitingMutual(before) && after.status == 'expired' &&
          request.time >= before.completionRequestedAt + duration.value(72,'h') &&
          changed.hasOnly(['status','settledAt','updatedAt']) && finishMutual(before,after))
      );
    }

    // User profile root document.
    match /users/{userId} {
      allow read: if signedIn() || (request.auth != null && request.auth.uid == userId);

      allow create: if isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.get('signupRewardVersion', 0) in [0, 2] &&
        request.resource.data.email is string &&
        request.resource.data.get('username', '') == '' && !request.resource.data.keys().hasAny(['usernameChangedAt']) &&
        request.resource.data.get('credits', 0) == 0 &&
        request.resource.data.get('lockedCredits', 0) == 0 &&
        request.resource.data.get('trustScore', 0) == 0 &&
        request.resource.data.get('verified', false) == false &&
        request.resource.data.get('verificationCount', 0) == 0 &&
        request.resource.data.get('peerApprovalCount', 0) == 0 && request.resource.data.get('portfolioTrust', 0) == 0 &&
        request.resource.data.get('portfolioSkillCounts', {}) == {};

      allow update: if signedIn() && request.resource.data.keys().hasAll(['lastExchangeSessionId','credits','lockedCredits']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits','lockedCredits']) && mutualWalletChange(userId);
      allow update: if isOwner(userId) && (immutableProfileFieldsUnchanged() || usernameChange(userId) ||
        (resource.data.get('signupRewardVersion', 0) != 2 && fixedGift(userId, 'first_match', 20)) ||
        fixedGift(userId, 'welcome', resource.data.get('signupRewardVersion', 0) == 2 ? 200 : 50));

      allow delete: if false;

      match /rewards/{rewardId} {
        allow read: if isOwner(userId);
        function welcomeAmount() {
          return get(/databases/$(database)/documents/users/$(userId)).data.get('signupRewardVersion', 0) == 2 ? 200 : 50;
        }
        function walletIncreasedBy(amount) {
          return getAfter(/databases/$(database)/documents/users/$(userId)).data.credits ==
            get(/databases/$(database)/documents/users/$(userId)).data.get('credits', 0) + amount;
        }
        allow create: if isOwner(userId) && request.resource.data.amount is int &&
          request.resource.data.createdAt == request.time && (
            (rewardId == 'welcome' &&
              request.resource.data.keys().hasOnly(['amount', 'createdAt']) &&
              request.resource.data.amount == welcomeAmount() && walletIncreasedBy(welcomeAmount())) ||
            (rewardId == 'first_match' &&
              get(/databases/$(database)/documents/users/$(userId)).data.get('signupRewardVersion', 0) != 2 &&
              request.resource.data.keys().hasOnly(['amount', 'matchId', 'createdAt']) &&
              request.resource.data.amount == 20 && request.resource.data.matchId is string &&
              get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.status == 'accepted' &&
              userId in get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.participants &&
              get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.requesterId !=
                get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.receiverId &&
              walletIncreasedBy(20))
          );
        allow update, delete: if false;
      }
      match /verificationRewards/{skillId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      // User-owned skill cards.
      match /teachSkills/{skillId} {
        allow read: if signedIn();
        allow create: if isOwner(userId) && !request.resource.data.keys().hasAny(['verifiedName', 'verifiedLevel', 'peerApprovalCount']);
        allow update: if isOwner(userId) && unchangedSkillVerification();
        allow delete: if isOwner(userId);
      }

      match /learnSkills/{skillId} {
        allow read: if signedIn();
        allow create: if isOwner(userId) && !request.resource.data.keys().hasAny(['verifiedName', 'verifiedLevel', 'peerApprovalCount']);
        allow update: if isOwner(userId) && unchangedSkillVerification();
        allow delete: if isOwner(userId);
      }
    }

    // A match can be read/updated only by participants.
    match /matches/{matchId} {
      allow read: if isParticipant(resource.data.participants);

      allow create: if signedIn() && request.resource.data.schemaVersion == 2 &&
        request.resource.data.keys().hasOnly(['id','schemaVersion','participants','initiatorId','recipientId','requesterName','receiverName','skillName','credits','deposits','status','createdAt','updatedAt']) &&
        request.resource.data.id == matchId && request.resource.data.initiatorId == request.auth.uid &&
        request.resource.data.recipientId != request.auth.uid && request.resource.data.status == 'pending' &&
        request.resource.data.participants.toSet() == [request.resource.data.initiatorId,request.resource.data.recipientId].toSet() &&
        getAfter(/databases/$(database)/documents/sessions/$(matchId)).data.requesterId == request.auth.uid;

      allow create: if signedIn() && request.resource.data.get('schemaVersion',0) != 2 && request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.receiverId != request.auth.uid && request.resource.data.status == 'pending' &&
        request.resource.data.participants.toSet() == [request.resource.data.requesterId, request.resource.data.receiverId].toSet() &&
        (request.resource.data.get('schemaVersion',0) != 2 ||
          getAfter(/databases/$(database)/documents/sessions/$(matchId)).data.requesterId == request.auth.uid);
      allow update: if isParticipant(resource.data.participants) && resource.data.get('schemaVersion',0) == 2 &&
        resource.data.status == 'pending' && request.auth.uid == resource.data.recipientId &&
        request.resource.data.status == 'accepted' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
        getAfter(/databases/$(database)/documents/sessions/$(matchId)).data.status == 'active';
      allow update: if isParticipant(resource.data.participants) && resource.data.get('schemaVersion',0) == 2 &&
        resource.data.status == 'pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
        ((request.auth.uid == resource.data.recipientId && request.resource.data.status == 'rejected') ||
         (request.auth.uid == resource.data.initiatorId && request.resource.data.status == 'cancelled')) &&
        getAfter(/databases/$(database)/documents/sessions/$(matchId)).data.status == 'cancelled';
      allow update: if isParticipant(resource.data.participants) && resource.data.get('schemaVersion',0) != 2 &&
        request.resource.data.requesterId == resource.data.requesterId &&
        request.resource.data.receiverId == resource.data.receiverId &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.skillName == resource.data.skillName &&
        request.resource.data.credits == resource.data.credits &&
        resource.data.status == 'pending' && (
          (request.auth.uid == resource.data.receiverId && request.resource.data.status == 'rejected') ||
          (request.auth.uid == resource.data.requesterId && request.resource.data.status == 'cancelled'));
      allow delete: if false;
    }

    // Session state is visible to teacher/student only.
    match /sessions/{sessionId} {
      allow read: if signedIn() && (resource.data.get('schemaVersion',0) == 2
        ? request.auth.uid in resource.data.participants
        : request.auth.uid in [resource.data.teacherId, resource.data.studentId]);

      function validSessionParties() {
        let m = getAfter(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data;
        return request.resource.data.teacherId == m.receiverId &&
          request.resource.data.studentId == m.requesterId &&
          request.resource.data.get('skill', request.resource.data.get('skillName', '')) == m.skillName &&
          request.resource.data.credits == m.credits &&
          (request.auth.uid == m.requesterId && request.resource.data.status == 'requested' && m.status == 'pending') && request.resource.data.get('funded', false) == false;
      }
      allow create: if signedIn() && (request.resource.data.get('schemaVersion',0) == 2
        ? newMutual(request.resource.data,sessionId) : validSessionParties());
      allow update: if signedIn() && resource.data.get('schemaVersion',0) == 2 && updateMutual(resource.data, request.resource.data);

      allow delete: if false;
    }

    // Financial ledgers should be server-controlled.
    match /transactions/{transactionId} {
      allow read: if signedIn() && request.auth.uid in [resource.data.fromUserId, resource.data.toUserId];
      allow write: if false;
    }

    match /escrows/{escrowId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if isParticipant(resource.data.participants);
      allow get: if signedIn() && chatId.matches('^face_.*') && !exists(/databases/$(database)/documents/chats/$(chatId));
      function confirmedConnectionChat() {
        let c = getAfter(/databases/$(database)/documents/profileConnections/$(chatId)).data;
        let d = request.resource.data;
        return c.status == 'confirmed' && d.participants == c.participants && request.auth.uid in c.participants &&
          d.keys().hasOnly(['id', 'participants', 'participantNames', 'kind', 'credits', 'status', 'createdAt', 'updatedAt']) &&
          d.id == chatId && d.kind == 'in_person' && d.credits == 0 && d.status == 'active' &&
          d.createdAt == request.time && d.updatedAt == request.time;
      }
      allow create: if signedIn() && chatId.matches('^face_.*') && confirmedConnectionChat();
      allow create: if signedIn() && !chatId.matches('^face_.*') &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;

      allow update: if isParticipant(resource.data.participants) &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastSenderId',
          'lastMessageAt',
          'participantNames',
          'skillName',
          'credits',
          'updatedAt',
          'unreadCount',
          'status'
        ]);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string;

        allow update: if isChatParticipant(chatId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);

        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && notificationId.matches('^face_.*') &&
        request.resource.data.keys().hasOnly(['userId', 'senderId', 'type', 'title', 'message', 'targetRoute', 'targetId', 'read', 'createdAt']) &&
        request.resource.data.senderId == request.auth.uid && request.resource.data.userId != request.auth.uid &&
        request.resource.data.type == 'profile_connection' && request.resource.data.targetRoute == '/find-profile' &&
        request.resource.data.targetId == request.auth.uid && request.resource.data.read == false && request.resource.data.createdAt == request.time;
      allow create: if signedIn() && !notificationId.matches('^face_.*') &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.senderId == request.auth.uid);
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /skillVerifications/{verificationId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid ||
        resource.data.status in ['approved', 'published'] || reviewer());
      allow write: if false;
    }
    match /communityPosts/{postId} {
      allow read: if signedIn() && (resource.data.status == 'published' || resource.data.authorId == request.auth.uid);
      allow write: if false;
      match /likes/{uid} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn() && get(/databases/$(database)/documents/communityPosts/$(postId)).data.status == 'published';
        allow write: if false;
      }
    }
    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
