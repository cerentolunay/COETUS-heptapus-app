rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isParticipant(participants) {
      return signedIn() && request.auth.uid in participants;
    }

    function isChatParticipant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function immutableProfileFieldsUnchanged() {
      return request.resource.data.credits == resource.data.credits &&
             request.resource.data.trustScore == resource.data.trustScore &&
             request.resource.data.verified == resource.data.verified &&
             request.resource.data.email == resource.data.email &&
             request.resource.data.id == resource.data.id;
    }

    // User profile root document.
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.email is string;

      allow update: if isOwner(userId) && immutableProfileFieldsUnchanged();

      allow delete: if false;

      // User-owned skill cards.
      match /teachSkills/{skillId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }

      match /learnSkills/{skillId} {
        allow read: if signedIn();
        allow write: if isOwner(userId);
      }
    }

    // A match can be read/updated only by participants.
    match /matches/{matchId} {
      allow read: if isParticipant(resource.data.participants);

      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;

      allow update: if isParticipant(resource.data.participants);
      allow delete: if false;
    }

    // Session state is visible to teacher/student only.
    match /sessions/{sessionId} {
      allow read: if signedIn() &&
        request.auth.uid in [resource.data.teacherId, resource.data.studentId];

      allow create: if signedIn() &&
        request.auth.uid in [request.resource.data.teacherId, request.resource.data.studentId];

      allow update: if signedIn() &&
        request.auth.uid in [resource.data.teacherId, resource.data.studentId];

      allow delete: if false;
    }

    // Financial ledgers should be server-controlled.
    match /transactions/{transactionId} {
      allow read: if signedIn() && request.auth.uid in [resource.data.fromUserId, resource.data.toUserId];
      allow write: if false;
    }

    match /escrows/{escrowId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow write: if false;
    }

    match /chats/{chatId} {
      allow read: if isParticipant(resource.data.participants);

      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants;

      allow update: if isParticipant(resource.data.participants) &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastSenderId',
          'updatedAt',
          'unreadCount',
          'status'
        ]);

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);

        allow create: if isChatParticipant(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string;

        allow update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() &&
        (request.resource.data.userId == request.auth.uid ||
         request.resource.data.senderId == request.auth.uid);
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
