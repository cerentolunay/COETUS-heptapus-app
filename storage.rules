rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function activeAccount() { return request.auth != null && !firestore.exists(/databases/(default)/documents/accountDeletions/$(request.auth.uid)); }
    function owner(uid) { return activeAccount() && request.auth.uid == uid; }
    function reviewer() { return activeAccount() && request.auth.token.get('verificationReviewer', false) == true; }
    function approved(requestId) {
      return firestore.exists(/databases/(default)/documents/skillVerifications/$(requestId)) &&
        firestore.get(/databases/(default)/documents/skillVerifications/$(requestId)).data.status == 'approved';
    }
    match /communityMedia/{uid}/{postId}/{filename} {
      allow read: if owner(uid) || (activeAccount() &&
        firestore.exists(/databases/(default)/documents/communityPosts/$(postId)) &&
        firestore.get(/databases/(default)/documents/communityPosts/$(postId)).data.status == 'published' &&
        firestore.get(/databases/(default)/documents/communityPosts/$(postId)).data.authorId == uid);
      allow create: if resource == null && owner(uid) &&
        !firestore.exists(/databases/(default)/documents/communityPosts/$(postId)) && request.resource.size > 0 && (
        (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 10 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/(mp4|quicktime|webm)') && request.resource.size <= 50 * 1024 * 1024));
      allow update: if false;
      allow delete: if owner(uid) && (!firestore.exists(/databases/(default)/documents/communityPosts/$(postId)) ||
        firestore.get(/databases/(default)/documents/communityPosts/$(postId)).data.status == 'deleted');
    }
    match /portfolioMedia/{uid}/{entryId}/{filename} {
      allow read: if owner(uid) || (activeAccount() &&
        firestore.exists(/databases/(default)/documents/skillVerifications/$(entryId)) &&
        firestore.get(/databases/(default)/documents/skillVerifications/$(entryId)).data.ownerId == uid &&
        firestore.get(/databases/(default)/documents/skillVerifications/$(entryId)).data.status == 'published');
      allow create: if resource == null && owner(uid) &&
        !firestore.exists(/databases/(default)/documents/skillVerifications/$(entryId)) && request.resource.size > 0 && (
        (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 10 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/(mp4|quicktime|webm)') && request.resource.size <= 50 * 1024 * 1024));
      allow update: if false;
      allow delete: if owner(uid) && (!firestore.exists(/databases/(default)/documents/skillVerifications/$(entryId)) ||
        firestore.get(/databases/(default)/documents/skillVerifications/$(entryId)).data.status == 'deleted');
    }
    match /verificationEvidence/{uid}/{requestId}/{filename} {
      allow read: if owner(uid) || reviewer() || (activeAccount() && approved(requestId));
      allow create: if resource == null && owner(uid) && request.resource.size > 0 && (
        (request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 10 * 1024 * 1024) ||
        (request.resource.contentType.matches('video/(mp4|quicktime|webm)') && request.resource.size <= 50 * 1024 * 1024));
      allow update: if false;
      allow delete: if owner(uid) && (
        !firestore.exists(/databases/(default)/documents/skillVerifications/$(requestId)) ||
        firestore.get(/databases/(default)/documents/skillVerifications/$(requestId)).data.status == 'rejected');
    }
  }
}
